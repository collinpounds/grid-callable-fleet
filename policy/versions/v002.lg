# Policy version 2
# What it does:
# During a grid event, first move batch work to the best other site if that site is
# outside the event zone and has spare room. Moved work still gets done, so the
# deadline is not put at risk. Whatever part of the requested cut cannot be moved
# is paused, as before. Together, moving and pausing deliver the full cut at once.
# Outside events, run batch work faster in two cases:
#   (a) The site is behind schedule and cannot finish by midnight at the usual rate.
#       It catches up as fast as its power limit allows.
#   (b) Power is likely clean or cheap: midday solar hours (9am to 4pm), or low carbon.
#       The site builds up about 150 minutes of extra slack, using at most half of its
#       spare power. This is capped so that batch work is still left to pause when an
#       evening event arrives.
# What changed from version 1:
# Version 1 only paused work, so 20.5 kWh missed the deadline. Version 2 adds moving
# during events, plus catch-up and clean-hour boosting outside events.
# No boosting ever happens at a site inside an active event.
# Every value is clamped so it is never negative and never exceeds batch, room or ownRoom.

## To pauseFor (s: Situation) -> Int:
    If s's event equals 1:
        Let mutable m be 0.
        If s's otherInEvent equals 0:
            Set m to minOf(minOf(s's target, s's batch), s's room).
            Set m to maxOf(m, 0).
        Let rest be maxOf(s's target - m, 0).
        Let avail be maxOf(s's batch - m, 0).
        Return maxOf(minOf(rest, avail), 0).
    Return 0.

## To moveFor (s: Situation) -> Int:
    If s's event equals 1:
        If s's otherInEvent equals 0:
            Let m be minOf(minOf(s's target, s's batch), s's room).
            Return maxOf(m, 0).
        Return 0.
    Return 0.

## To boostFor (s: Situation) -> Int:
    If s's event equals 1:
        Return 0.
    If s's backlog is less than 1:
        Return 0.
    If s's ownRoom is less than 1:
        Return 0.
    # Catch up if the remaining work cannot finish by midnight at the usual rate.
    Let plan be s's batch * s's left.
    Let deficit be s's backlog - plan.
    If deficit is greater than 0:
        Return maxOf(minOf(deficit, s's ownRoom), 0).
    # Build extra slack during likely clean or cheap hours.
    Let mutable clean be 0.
    If s's minute is greater than 539 and s's minute is less than 960:
        Set clean to 1.
    If s's carbon is less than 200:
        Set clean to 1.
    If clean equals 1:
        Let horizon be maxOf(s's left - 30, 0).
        Let keep be s's batch * horizon.
        Let extra be s's backlog - keep.
        Let half be s's ownRoom / 2.
        Return maxOf(minOf(extra, half), 0).
    Return 0.
