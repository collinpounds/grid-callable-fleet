# Policy version 14
# What it does:
# During a grid event, batch work first moves to the best other site, if that site is
# outside the event zone and has spare room. Any part of the requested cut that cannot
# be moved is paused. Together they deliver the full cut at once. This is unchanged.
# Outside events, batch work is shifted toward clean, cheap midday solar hours:
#   (a) Before 9am with dirty power (carbon 250 or more), batch work is paused. It is only
#       paused if the site could still catch up with spare power in the 9am to 4pm window.
#       If the site falls too far behind before 9am, it catches up at once.
#   (b) From 9am to 4pm the site runs extra batch work, spread over the window so the
#       day's work is done by about 3pm. It runs more in the cleanest and cheapest
#       intervals.
#   (c) After 4pm the site catches up right away if it cannot finish by midnight. It also
#       finishes early if power is clean or cheap before 6pm.
# What changed from version 13:
#   - The last two versions gained the most by moving dirty overnight work into solar
#     hours, so version 14 moves more: the overnight pause budget rises from 30 to 36
#     intervals of spare power, and the catch-up trigger rises from 34 to 40 to match.
#     The 9am to 4pm window has about 84 intervals of spare power, so this still leaves
#     a wide safety margin for the deadline.
# No boosting ever happens at a site inside an active event.
# Every value is clamped so it is never negative and never exceeds batch, room or ownRoom.

## To pauseFor (s: Situation) -> Int:
    If s's event equals 1:
        Let mutable m be 0.
        If s's otherInEvent equals 0:
            Set m to minOf(minOf(s's target, s's batch), s's room).
            Set m to maxOf(m, 0).
        Let rest be maxOf(s's target - m, 0).
        Let avail be maxOf(s's batch - m, 0).
        Return maxOf(minOf(rest, avail), 0).
    # Morning shift: pause dirty work before 9am only if the solar window can absorb it.
    If s's minute is less than 540 and s's carbon is greater than 249 and s's batch is greater than 0:
        Let nextLeft be s's left - 1.
        Let nextPlan be s's batch * nextLeft.
        Let after be s's backlog - nextPlan.
        Let room36 be maxOf(s's ownRoom, 0) * 36.
        If after is less than room36:
            Return maxOf(s's batch, 0).
        Return 0.
    Return 0.

## To moveFor (s: Situation) -> Int:
    If s's event equals 1:
        If s's otherInEvent equals 0:
            Let m be minOf(minOf(s's target, s's batch), s's room).
            Return maxOf(m, 0).
        Return 0.
    Return 0.

## To boostFor (s: Situation) -> Int:
    If s's event equals 1:
        Return 0.
    If s's backlog is less than 1:
        Return 0.
    If s's ownRoom is less than 1:
        Return 0.
    Let cap be maxOf(s's ownRoom, 0).
    Let plan be s's batch * s's left.
    Let deficit be s's backlog - plan.
    # Before 9am: only catch up if too far behind, or boost if power is very clean.
    If s's minute is less than 540:
        Let safe be cap * 40.
        If deficit is greater than safe:
            Let over be deficit - safe.
            Return maxOf(minOf(over, cap), 0).
        If s's carbon is less than 200:
            Let gapA be 960 - s's minute.
            Let rA be gapA / 5.
            Let keepA be s's batch * rA.
            Let extraA be s's backlog - keepA.
            Return maxOf(minOf(extraA, cap), 0).
        Return 0.
    # 9am to 4pm: spread extra work so the day's work is done by about 3pm.
    If s's minute is less than 960:
        Let gapB be 960 - s's minute.
        Let rB be gapB / 5.
        Let keepB be s's batch * rB.
        Let extraB be s's backlog - keepB.
        If extraB is less than 1:
            Return 0.
        # Free or negative-price power: use all spare power.
        If s's price is less than 1:
            Return maxOf(minOf(extraB, cap), 0).
        Let spread be maxOf(rB - 12, 1).
        Let mutable want be extraB / spread + 1.
        # Very clean power: run twice the even rate.
        If s's carbon is less than 150:
            Set want to want * 2.
        Return maxOf(minOf(minOf(want, extraB), cap), 0).
    # After 4pm: catch up at once if midnight is at risk.
    If deficit is greater than 0:
        Return maxOf(minOf(deficit, cap), 0).
    If s's carbon is less than 200:
        Return maxOf(minOf(s's backlog, cap), 0).
    If s's minute is less than 1080 and s's price is less than 1500:
        Return maxOf(minOf(s's backlog, cap), 0).
    Return 0.
